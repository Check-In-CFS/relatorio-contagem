# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (local: saída do `supabase start`; nuvem: Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-anon-key-aqui

# Chave de serviço (service_role) — SOMENTE servidor, nunca com prefixo NEXT_PUBLIC_.
# Usada pela tela Administração → Usuários para criar usuários e redefinir senhas.
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui
